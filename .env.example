# Host-run Next.js connects to the Lerd MongoDB service on localhost.
# Preset credentials are for PRIVATE LOCAL DEVELOPMENT ONLY.
# MongoDB authenticates the `root` user against the admin database.
MONGODB_URI=mongodb://root:lerd@127.0.0.1:27017/taskloom?authSource=admin
MONGODB_DB=taskloom

# Optional private S3 bucket for task attachments (Laravel-compatible AWS env names).
# Leave AWS_BUCKET blank to disable attachments; MongoDB tasks work without S3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
# Optional custom S3-compatible service (MinIO, R2); blank for AWS S3.
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Optional temporary IAM credentials
AWS_SESSION_TOKEN=
# Compatible aliases also accepted: S3_BUCKET, S3_REGION, S3_ENDPOINT,
# S3_FORCE_PATH_STYLE, AWS_REGION.

# Lerd RustFS with host-run Next.js (e.g. systemd lerd-app-taskloom.service):
# Lerd injects AWS_ENDPOINT=http://lerd-rustfs:9000, which generally resolves only
# inside its container network. TASKLOOM_S3_ENDPOINT takes priority over AWS_ENDPOINT
# even if Lerd injects AWS_ENDPOINT into the Node process.
# TASKLOOM_S3_ENDPOINT=http://127.0.0.1:9000
# TASKLOOM_S3_BUCKET=lerd
# Lerd example credentials: lerd / lerdpassword; default region us-east-1.
# Do NOT append /insure360 or /taskloom to the endpoint URL.
# Use TASKLOOM_S3_BUCKET=taskloom only if that bucket actually exists.
# Check that localhost:9000 is published by Lerd; otherwise use your real host URL.
