# Host-run Next.js connects to the Lerd MongoDB service on localhost.
# Preset credentials are for PRIVATE LOCAL DEVELOPMENT ONLY.
# MongoDB authenticates the `root` user against the admin database.
MONGODB_URI=mongodb://root:lerd@127.0.0.1:27017/taskloom?authSource=admin
MONGODB_DB=taskloom

# Optional private S3 bucket for task attachments (Laravel-compatible AWS env names).
# Leave AWS_BUCKET blank to disable attachments; MongoDB tasks work without S3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
# Optional custom S3-compatible service (MinIO, R2); blank for AWS S3.
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Optional temporary IAM credentials
AWS_SESSION_TOKEN=
# Compatible aliases also accepted: S3_BUCKET, S3_REGION, S3_ENDPOINT,
# S3_FORCE_PATH_STYLE, AWS_REGION.
